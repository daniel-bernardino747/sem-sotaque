# Postgres. In docker compose the app gets this from docker-compose.yml.
DATABASE_URL=postgres://sem_sotaque:sem_sotaque@localhost:5432/sem_sotaque
ANTHROPIC_API_KEY=
# "local" (one user, on your own machine) or "hospedado" (the hosted product).
# Empty: hospedado. docker-compose.local.yml sets local (src/modo.ts).
MODO=
# "assinatura" calls the model through your Claude subscription (`claude -p`
# logged in on the host, src/llm/assinatura.ts) instead of the API. Only with
# MODO=local, and only natively: README.md says why. Empty: the API.
LLM_BACKEND=
# The evaluator's classifier, the Jev (src/avaliador/jev.ts). Optional: empty,
# the evaluator follows its fixed rules.
TYPESAFE_API_KEY=
# Hosted only: token for Daniel's panel (/admin, step 08). At least 16 characters, or the panel stays closed.
ADMIN_TOKEN=
# Public URL of the app: the v0 links sent to testers and the OAuth callbacks.
APP_URL=http://localhost:3000
# Spending cap per session, in USD (src/llm/cliente.ts). Empty: US$ 3.
TETO_SESSAO_USD=
# Hosted only: the WhatsApp number the landing's invitation links open, digits
# with the country code (src/app/contato.ts). Empty: the links send an e-mail.
CONTATO_WHATSAPP=

# Login (step 20, src/conta/oauth.ts). One OAuth app per provider, with the
# callback at $APP_URL/api/auth/callback/github and .../google. A provider left
# empty does not show on /entrar. The sign-in cookie needs no secret: it holds
# a random value and the database keeps its SHA-256 (table `acessos`).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Subscription (step 21, src/assinatura/). Hosted only: MODO=local has no
# payment. Test mode keys (sk_test_...) for dev; docs/deploy.md has the setup.
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints the
# webhook secret for a local run.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The one Price: R$ 99 every 3 months.
STRIPE_PRICE_ID=
